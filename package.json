{
  "name": "ocean-adventure-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "make:assets": "node scripts/run_blender.mjs",
    "cf:projects": "wrangler pages project list",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name ocean-adventure-game --branch main"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.107.0"
  }
}
